<mxfile host="app.diagrams.net" agent="Antigravity">
  <diagram id="MVC_Architecture_WorkTracker" name="MVC Architecture Overview">
    <mxGraphModel dx="1285" dy="1556" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="850" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=24;fontStyle=1;fontFamily=Times New Roman;fontColor=#000000;" value="WorkTracker System - Model-View-Controller (MVC) Architecture Overview" vertex="1">
          <mxGeometry height="40" width="800" x="200" y="-80" as="geometry" />
        </mxCell>
        <mxCell id="actor_user" parent="1" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontStyle=1;fontSize=15;fontFamily=Times New Roman;fillColor=#ffffff;strokeColor=#000000;strokeWidth=1.5;" value="User&#xa;(Admin / Manager / Employee)" vertex="1">
          <mxGeometry height="80" width="50" x="570" y="-10" as="geometry" />
        </mxCell>
        <mxCell id="box_view" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontFamily=Times New Roman;align=center;verticalAlign=middle;fontSize=15;" value="&lt;b&gt;VIEW (Presentation Layer - React.js Frontend)&lt;/b&gt;&lt;br&gt;&lt;span&gt;• Single Page Application (SPA), React Components, Tailwind CSS &amp;amp; Lucide Icons&lt;br&gt;• Interactive Kanban Board (@dnd-kit), Split-pane QA Review Cockpit, Floating Chat Drawer&lt;/span&gt;" vertex="1">
          <mxGeometry height="95" width="760" x="220" y="230" as="geometry" />
        </mxCell>
        <mxCell id="box_controller" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontFamily=Times New Roman;align=center;verticalAlign=middle;fontSize=15;" value="&lt;b&gt;CONTROLLER (Business Logic &amp;amp; Routing - Django REST Framework)&lt;/b&gt;&lt;br&gt;&lt;span&gt;• API ViewSets, Serializers &amp;amp; Input Validation (24h Daily Limit, LexoRank Ordering, Time Lock Rules)&lt;br&gt;• 2-Tier RBAC Authentication Middleware (JWT) &amp;amp; Django Channels Consumers (WebSockets)&lt;/span&gt;" vertex="1">
          <mxGeometry height="100" width="760" x="220" y="430" as="geometry" />
        </mxCell>
        <mxCell id="box_model" parent="1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=10;fillColor=#ffffff;strokeColor=#000000;strokeWidth=2;fontFamily=Times New Roman;align=center;verticalAlign=middle;fontSize=15;" value="&lt;b&gt;MODEL (Data Layer - Django ORM &amp;amp; PostgreSQL Database)&lt;/b&gt;&lt;br&gt;&lt;span&gt;• 21 Relational Database Models (Users, Roles, Jobs, Tasks, LogWorks, TimeLocks, Chat Messages)&lt;br&gt;• Object-Relational Mapping (ORM), 3NF Relational Schema, ACID Transactions &amp;amp; Redis Layer&lt;/span&gt;" vertex="1">
          <mxGeometry height="95" width="760" x="220" y="635" as="geometry" />
        </mxCell>
        <mxCell id="edge_user_view" edge="1" parent="1" source="actor_user" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Times New Roman;fontSize=15;fontColor=#000000;strokeColor=#000000;strokeWidth=1.5;align=center;verticalAlign=bottom;" target="box_view" value="1. User Interactions &lt;br&gt;(Clicks, Inputs, Drag-and-drop)">
          <mxGeometry relative="1" x="0.6522" as="geometry">
            <mxPoint as="offset" />
            <Array as="points">
              <mxPoint x="390" y="30" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge_view_user" edge="1" parent="1" source="box_view" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontFamily=Times New Roman;fontSize=15;fontColor=#000000;strokeColor=#000000;strokeWidth=1.5;align=center;verticalAlign=bottom;" target="actor_user" value="6. Render Dynamic UI &lt;br&gt;&amp;amp; Visual Alerts">
