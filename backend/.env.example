# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets, only this template.

# ── CORE ─────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# ── DATABASE (PostgreSQL, local per dev) ────────────────────────────────────
DB_NAME=worktracker_db
DB_USER=postgres
DB_PASSWORD=your-local-postgres-password
DB_HOST=127.0.0.1
DB_PORT=5432

# ── REDIS (JWT blacklist cache) ──────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── EMAIL (Gmail SMTP — used by Forgot Password) ────────────────────────────
# EMAIL_HOST_USER must be a real Gmail address.
# EMAIL_HOST_PASSWORD must be a Google App Password (16 chars, no spaces),
# NOT your normal Gmail password — generate one at
# myaccount.google.com/apppasswords (requires 2-Step Verification enabled).
EMAIL_HOST_USER=your-address@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password

# ── FRONTEND (used to build links inside emails, e.g. reset-password) ──────
FRONTEND_URL=http://localhost:5173

# ── BUSINESS RULES (timesheets) ─────────────────────────────────────────────
WORK_DAYS_PER_WEEK=6
DAILY_WORKING_HOURS=8
